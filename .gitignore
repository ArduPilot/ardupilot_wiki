# Claude Code local tooling (commands, settings) - never part of the upstream wiki
/.claude/

# Common files except under Common
/*/source/docs/common-*
!/common/source/docs/common-*

# Template overrides copied into each wiki by update.py; the originals live in
# common/_templates and are the only copy that should be edited or committed.
/*/source/_templates/
!/common/_templates/

# Common CSS except under Common
/*/source/_static/common_*
!/common/source/_static/common_*

# Any build directory
*/build/*

# Logs
*.log

# Build outputs
*.html
*.pyc
.cache/
new_params_mversion/
old_params_mversion/

# static html pages
!/frontend/*.html
!/frontend/includes/*.html

# Sphinx template overrides, copied into each wiki by update.py
!/common/_templates/*.html


# Generated offline artefacts (archives + manifest), rebuilt by update.py
/offline/

# Lossless PNG results, keyed by content hash. Safe to delete; the next
# build refills it.
/.image-cache/

# Vagrant
/.vagrant

# VSCode
/.vscode
/.idea
/.venv

# Vim swap files
*.swp


# Parameters files
/*/source/docs/parameters*.rst
/dev/source/docs/AP_Periph-Parameters.rst
/*/source/_static/parameters-*.json

# Log messages files
/*/source/docs/logmessages.rst

# Binary features files
/*/source/docs/binary-features.rst
features.json.gz
build_options.py

# Javascript files
/*/source/_static/useralerts.js

# Website
/frontend/blog_posts.json
/frontend/news_posts.json
/frontend/source/_static/common_theme_override.css

# Mac file
.DS_Store

# Test-only dependency, installed on demand rather than vendored:
#   npm install --no-save jsdom
/node_modules/
/package-lock.json
build.lck
build.lck.log
