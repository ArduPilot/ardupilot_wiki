{
  "name": "ardupilot-wiki",
  "private": true,
  "description": "Test suites for the offline reading feature (service worker, offline page, exporter). The wiki is built by update.py; npm is needed only to run these tests.",
  "scripts": {
    "test": "node scripts/tests/run_all.js",
    "test:worker": "node scripts/tests/test_offline_worker.js",
    "test:panel": "node scripts/tests/test_offline_page.js",
    "test:export": "node scripts/tests/test_offline_export.js",
    "test:export:multi": "node scripts/tests/test_offline_export.js ardupilot planner2 antennatracker",
    "test:export:full": "node --max-old-space-size=8192 scripts/tests/test_offline_export.js --full",
    "test:archives": "python3 scripts/tests/test_offline_archives.py",
    "test:browsers": "node scripts/tests/run_all.js --only browsers",
    "serve": "node scripts/tests/serve_wiki_tree.js 8000",
    "test:images": "python3 scripts/tests/test_optimise_images.py",
    "test:all": "node scripts/tests/run_all.js --only all"
  },
  "devDependencies": {
    "jsdom": "29.1.1",
    "playwright": "1.62.1"
  }
}
